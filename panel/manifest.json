{
  "manifestVersion": 5,
  "id": "com.crispenstanbach.canvas-render",
  "name": "Canvas Render",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["canvas-render"],
      "extensions": []
    }
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "canvas-render-panel",
      "label": {
        "default": "Canvas Render"
      },
      "minimumSize": { "width": 300, "height": 400 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 680 }
    }
  ]
}
